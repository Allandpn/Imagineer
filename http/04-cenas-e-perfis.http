### Cria um perfil de renderização (estilo visual, reutilizável entre livros)
POST {{baseUrl}}/perfis-renderizacao
Content-Type: application/json

{
  "nome": "Aquarela sombria de teste",
  "estilo": "aquarela, traços soltos, sombras marcadas",
  "artista_referencia": null,
  "iluminacao": "luz de vela",
  "paleta": "tons terrosos e cinza",
  "formato": "retrato"
}

> {%
    client.global.set("perfilId", response.body.id);
    client.test("Criou o perfil", function () {
        client.assert(response.status === 201, "esperava 201, veio " + response.status);
    });
%}

### Lista os perfis
GET {{baseUrl}}/perfis-renderizacao

### Abre um perfil
GET {{baseUrl}}/perfis-renderizacao/{{perfilId}}

### Ajusta um perfil
PATCH {{baseUrl}}/perfis-renderizacao/{{perfilId}}
Content-Type: application/json

{
  "iluminacao": "luz de vela, contraste forte"
}

### Define este perfil como o padrão do livro
# Rode 01-livros.http antes, para ter livroId.
PATCH {{baseUrl}}/livros/{{livroId}}
Content-Type: application/json

{
  "perfil_renderizacao_padrao_id": {{perfilId}}
}

### Cria uma cena, já ligada ao estado do elemento (passo 6.4)
# Rode 03-elementos-e-estados.http antes, para ter estadoId.
POST {{baseUrl}}/capitulos/{{primeiroCapituloId}}/cenas
Content-Type: application/json

{
  "titulo": "Cena de teste",
  "descricao": "Uma descrição qualquer da cena, para servir de contexto ao prompt",
  "horario": "fim de tarde",
  "clima": "céu limpo",
  "humor": "tensão contida",
  "estados_ids": [
    {{estadoId}}
  ]
}

> {%
    client.global.set("cenaId", response.body.id);
    client.test("Criou a cena com o elemento", function () {
        client.assert(response.status === 201, "esperava 201, veio " + response.status);
        client.assert(response.body.elementos.length === 1, "esperava 1 elemento na cena");
    });
%}

### Lista as cenas do capítulo
GET {{baseUrl}}/capitulos/{{primeiroCapituloId}}/cenas

### Abre a cena, com os elementos e o estado de cada um
GET {{baseUrl}}/cenas/{{cenaId}}

### Ajusta título, descrição ou atributos situacionais da cena
PATCH {{baseUrl}}/cenas/{{cenaId}}
Content-Type: application/json

{
  "humor": "tensão crescente"
}

### Substitui a lista completa de estados da cena (o app manda o conjunto inteiro)
PUT {{baseUrl}}/cenas/{{cenaId}}/estados
Content-Type: application/json

{
  "estados_ids": [
    {{estadoId}}
  ]
}

### Remove a cena — não apaga os estados que ela citava
# DELETE {{baseUrl}}/cenas/{{cenaId}}

### Remove o perfil — não apaga livros nem prompts, só desfaz a referência
# DELETE {{baseUrl}}/perfis-renderizacao/{{perfilId}}
