# Copie este arquivo para ".env" e preencha os valores reais.
# O ".env" nunca deve ser versionado (já está no .gitignore).

# Senha do usuário do PostgreSQL. Lida pelo docker-compose ao subir a stack.
SENHA_BANCO=senha_local

# Conexão com o PostgreSQL.
#
# Dentro do Docker o banco é alcançado pelo nome do serviço ("db"). Fora dele,
# use "127.0.0.1" e NÃO "localhost": no Windows, "localhost" resolve para IPv6
# (::1) antes de IPv4, e o Docker publica a porta só em IPv4 — a conexão fica
# esperando o timeout expirar antes de tentar o endereço certo.
URL_BANCO=postgresql+psycopg://imagineer:senha_local@127.0.0.1:5432/imagineer

# Chave de API do OpenRouter (https://openrouter.ai/keys).
# Pode ficar vazia enquanto a integração com IA não estiver implementada.
CHAVE_API_OPENROUTER=

# Pasta onde as imagens do catálogo são gravadas.
# Dentro do container, corresponde ao volume montado no docker-compose.
DIRETORIO_IMAGENS=/dados/imagens
