# Segredos — nunca versionar
.env

# Ambiente virtual Python
venv/
.venv/

# Artefatos do Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Dados locais (imagens do catálogo e volume do banco) — só a pasta da raiz,
# não qualquer diretório chamado "dados" (ex.: android/app/.../dados/)
/dados/

# IDE
.idea/

# Sistema operacional
Thumbs.db
.DS_Store

# Android (app/)
android/local.properties
android/.gradle/
android/build/
android/*/build/
android/.kotlin/
android/captures/
android/*.keystore
android/*.jks

